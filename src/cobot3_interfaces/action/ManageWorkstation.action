# Goal: 작업대 통째로 이동 명령
string workstation_id      # 대상 작업대 ID
string start_location      # 출발지 (예: "sg2_in_01", "warehouse")
string target_location     # 목적지 (예: "warehouse", "sg2_out_00")
string workstation_qr_id   # 작업대 QR코드 ID
string target_qr_id        # 목적지 바닥 QR ID
float64 target_x           # 목적지 X 좌표 (m)
float64 target_y           # 목적지 Y 좌표 (m)
float64 target_yaw         # 목적지 Yaw 각도 (rad)


---
# Result: 작업대 이동 완료 결과
bool success               # 이동 및 안착 성공 여부
---
# Feedback: 작업대 운반 상태
float32 distance_remaining # 목적지까지 남은 거리 (m)
string status              # 현재 상태 ("PICKING", "NAVIGATING", "PLACING")
