# Request: 적재 진척도 보고
string workstation_id      # 현재 적재 중인 작업대 ID
string robot_id            # 보고하는 로봇 ID (예: "sg2_in_01")
int32 filled_slots_count   # 현재 채워진 칸의 개수 (1 ~ 4)
string package_id          # 적재된 택배 ID
int32 workstation_aruco_id # 작업대 ArUco 마커 ID
int32 package_aruco_id     # 적재된 택배 ArUco 마커 ID
---
# Response: 수신 확인
bool success               # 관제탑의 접수 성공 여부
